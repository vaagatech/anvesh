{
  "family": "anvesh",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/anveshTaskRole",
  "containerDefinitions": [
    {
      "name": "anvesh",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/anvesh:0.1.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3848,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        { "name": "ANVESH_STORAGE", "value": "redis" },
        { "name": "ANVESH_PORT", "value": "3848" },
        { "name": "ANVESH_LOG_PRETTY", "value": "0" },
        { "name": "REDIS_URL", "value": "redis://your-elasticache:6379" }
      ],
      "secrets": [
        {
          "name": "ANVESH_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:anvesh/api-key"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3848/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/anvesh",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "anvesh"
        }
      }
    }
  ]
}
