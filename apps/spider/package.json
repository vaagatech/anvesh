{
  "name": "@vaagatech/anvesh-spider",
  "version": "0.4.0",
  "description": "Anvesh site spider — full-site crawl with role-based post-login discovery — by VaagaTech",
  "type": "module",
  "bin": {
    "anvesh-spider": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "author": "VaagaTech <info@vaagatech.com>",
  "license": "MIT",
  "homepage": "https://www.vaagatech.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaagatech/anvesh-monorepo.git",
    "directory": "apps/spider"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@vaagatech/anvesh-shared": "0.4.0",
    "better-sqlite3": "^13.0.3",
    "linkedom": "^0.18.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
