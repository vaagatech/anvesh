# Local Anvesh data directory (Node.js filesystem storage — default)
ANVESH_DATA_DIR=.anvesh/data

# Local default: filesystem. No Docker, Redis, or cloud services required.
# memory | filesystem | s3 | redis | dynamodb | mongodb
ANVESH_STORAGE=filesystem

# HTTP
ANVESH_HOST=127.0.0.1
ANVESH_PORT=3848
ANVESH_API_KEY=
ANVESH_CORS_ORIGIN=*
ANVESH_RATE_LIMIT=120
ANVESH_LOG_LEVEL=info
ANVESH_LOG_PRETTY=1

# --- Only needed when you choose a non-filesystem backend ---

# S3 / MinIO
ANVESH_S3_BUCKET=
ANVESH_S3_PREFIX=anvesh/indexes/
ANVESH_S3_ENDPOINT=
AWS_REGION=us-east-1

# Redis
REDIS_URL=redis://127.0.0.1:6379

# DynamoDB
ANVESH_DDB_TABLE=anvesh-indexes
ANVESH_DDB_ENDPOINT=

# MongoDB
ANVESH_MONGO_URL=mongodb://127.0.0.1:27017
ANVESH_MONGO_DB=anvesh
