# =========================================================================
# Anvesh Hub Control Plane & Service Registry Microservice Dockerfile
# Ultra-lightweight API gateway and instance orchestrator
# =========================================================================
FROM node:24-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json* turbo.json ./
COPY packages/shared packages/shared
COPY packages/search-adapters packages/search-adapters
COPY apps/hub-api apps/hub-api

RUN npm install
RUN npm run build -w @vaagatech/anvesh-shared -w @vaagatech/anvesh-search-adapters -w @vaagatech/anvesh-hub-api

FROM node:24-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache libstdc++

ENV NODE_ENV=production
ENV ANVESH_HUB_DATA=/data/hub
ENV ANVESH_HUB_PORT=3849
ENV ANVESH_HOST=0.0.0.0
ENV ANVESH_LOG_PRETTY=0

RUN addgroup -S anvesh && adduser -S anvesh -G anvesh
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/packages/search-adapters ./packages/search-adapters
COPY --from=build /app/apps/hub-api ./apps/hub-api

RUN mkdir -p /data/hub /tmp && chown -R anvesh:anvesh /data /tmp /app
USER anvesh
WORKDIR /app
EXPOSE 3849
CMD ["node", "apps/hub-api/dist/cli.js", "serve"]
