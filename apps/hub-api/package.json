{
  "name": "@vaagatech/anvesh-hub-api",
  "version": "0.4.0",
  "description": "Anvesh Hub API — control plane with RBAC for engine, indexer, and spider instances — by VaagaTech",
  "type": "module",
  "bin": {
    "anvesh-hub": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "author": "VaagaTech <info@vaagatech.com>",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.0",
    "@vaagatech/anvesh-search-adapters": "0.4.0",
    "@vaagatech/anvesh-shared": "0.4.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}