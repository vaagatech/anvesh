{
  "name": "@vaagatech/anvesh-hub",
  "version": "0.2.0",
  "description": "Anvesh Hub — control plane with RBAC for engine, indexer, and spider instances — by VaagaTech",
  "type": "module",
  "bin": {
    "anvesh-hub": "./dist/server/cli.js"
  },
  "main": "./dist/server/server.js",
  "types": "./dist/server/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx watch server/src/cli.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/server/cli.js",
    "lint": "tsc -p tsconfig.server.json --noEmit"
  },
  "author": "VaagaTech <info@vaagatech.com>",
  "license": "MIT",
  "homepage": "https://www.vaagatech.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaagatech/anvesh-monorepo.git",
    "directory": "apps/hub"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
